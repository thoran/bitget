#!/usr/bin/env ruby
# generate_error_codes

# 20260925
# 0.0.0

# Writes lib/Bitget/ERROR_CODES.rb from the error code lists Bitget publishes as Markdown.
# Each list is kept separately, since a code shared between lists is not certain to mean the
# same thing in each, and a code is not certain to be unique within a list either.

require 'cgi/escape'
require 'open-uri'

SOURCES = {
  v2_rest: 'https://www.bitget.com/docs/classic/error-code/restapi.md',
  v2_websocket: 'https://www.bitget.com/docs/classic/error-code/websocket.md',
  uta_rest: 'https://www.bitget.com/docs/uta/error-code/restapi.md',
}

# Bitget's placeholder for a code it has not described.
UNDESCRIBED = '未找到描述'

def output_path
  File.expand_path('../lib/Bitget/ERROR_CODES.rb', __dir__)
end

def markdown(url)
  URI.open(url, &:read).force_encoding('UTF-8')
end

# A row is "| code | message |", the closing pipe sometimes missing, where the code may be a
# link: "[25102](./...)", and the message may carry HTML entities: "&gt;".
def rows(markdown)
  markdown.lines.grep(/\A\|\s*\[?\d/).map do |line|
    code, message = fields(line)
    [code[/\d+/], checked(CGI.unescapeHTML(message), line)]
  end
end

# A pipe in a message would split it across columns.
def fields(line)
  _, *fields = line.chomp.sub(/\|\s*\z/, '').split('|').map(&:strip)
  abort "A row has a pipe in its message: #{line}" unless fields.size == 2
  fields
end

# Bitget::Error#documented_message numbers the messages of a code listed more than once,
# "(1) ...; (2) ...", which is unambiguous only while no message contains such a number.
def checked(message, line)
  abort "A row has a message numbered as Bitget::Error#documented_message numbers them: #{line}" if message =~ /\(\d+\)/
  message
end

def source_rows
  @source_rows ||= SOURCES.transform_values{|url| rows(markdown(url))}
end

# A code listed more than once in the one list keeps each of its messages, as an array.
def error_codes(rows)
  rows.reject{|_code, message| message == UNDESCRIBED}.group_by(&:first).transform_values do |code_rows|
    messages = code_rows.map(&:last).uniq
    messages.one? ? messages.first : messages
  end
end

def tables
  @tables ||= source_rows.transform_values{|rows| error_codes(rows)}
end

def conflicting_codes
  tables.values.flat_map(&:keys).uniq.sort.select do |code|
    tables.values.filter_map{|error_codes| error_codes[code]}.map{|message| Array(message).map(&:downcase)}.uniq.size > 1
  end
end

def duplicated_codes
  tables.flat_map{|name, error_codes| error_codes.select{|_code, message| message.is_a?(Array)}.keys.map{|code| "#{code} (#{name})"}}
end

def undescribed_codes
  source_rows.flat_map{|name, rows| rows.select{|_code, message| message == UNDESCRIBED}.map{|code, _message| "#{code} (#{name})"}}
end

def listing(codes)
  codes.empty? ? 'none' : codes.join(', ')
end

def notes
  [
    "Codes whose message differs between lists: #{listing(conflicting_codes)}",
    "Codes listed more than once in the one list, their messages kept as an array: #{listing(duplicated_codes)}",
    "Codes omitted for having only Bitget's placeholder, #{UNDESCRIBED}, for a message: #{listing(undescribed_codes)}",
  ]
end

def table_source(name, codes)
  entries = codes.sort.map{|code, message| "      #{code.inspect} => #{message.inspect},"}
  ["    #{name}: {", entries, "    }.freeze,"]
end

def source
  [
    '# Bitget/ERROR_CODES.rb',
    '# Bitget::ERROR_CODES',
    '',
    "# Generated by bin/generate_error_codes on #{Time.now.strftime('%Y%m%d')}; not to be edited by hand.",
    '# One table per list Bitget publishes, in order of precedence:',
    SOURCES.map{|name, url| "#   #{name}: #{url}"},
    '#',
    notes.map{|note| "# #{note}"},
    '',
    'module Bitget',
    '  ERROR_CODES = {',
    tables.map{|name, codes| table_source(name, codes)},
    '  }.freeze',
    'end',
  ].flatten.join("\n") + "\n"
end

def report
  tables.each{|name, codes| puts "#{name}: #{codes.size}"}
  puts notes
end

def main
  File.write(output_path, source)
  report
end

main
